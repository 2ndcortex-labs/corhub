#!/bin/sh
# git credential helper for per-owner GitHub tokens.
# Answers only for github.com and only when git asks with a username of the form
# corhub.<owner>; every other request is left to the next helper (gh).
# Tokens are kept by the machine's own credential store where git ships one,
# otherwise in a private file. Nothing is ever printed except to git.
set -eu
op="${1:-}"
host=""; user=""; pass=""
while IFS= read -r line; do
  case "$line" in
    host=*) host="${line#host=}" ;;
    username=*) user="${line#username=}" ;;
    password=*) pass="${line#password=}" ;;
    "") break ;;
  esac
done
[ "$host" = "github.com" ] || exit 0
case "$user" in corhub.?*) ;; *) exit 0 ;; esac

dir="${XDG_CONFIG_HOME:-$HOME/.config}/corhub"
exe="$(git --exec-path)"
if [ -x "$exe/git-credential-osxkeychain" ]; then
  backend="osxkeychain"
else
  mkdir -p "$dir"; chmod 700 "$dir"
  backend="store --file=$dir/credentials"
fi

ask() {
  printf 'protocol=https\nhost=github.com\nusername=%s\n' "$user"
  [ -z "$pass" ] || printf 'password=%s\n' "$pass"
  printf '\n'
}

case "$op" in
  get)
    # shellcheck disable=SC2086
    out="$(ask | git credential-$backend get 2>/dev/null || true)"
    found="$(printf '%s\n' "$out" | sed -n 's/^password=//p' | head -n 1)"
    if [ -n "$found" ]; then
      printf 'username=%s\npassword=%s\n' "$user" "$found"
    else
      # A corhub.<owner> request with nothing stored: stop here, so no other
      # helper answers with a token that belongs to a different owner.
      printf 'quit=true\n'
    fi
    ;;
  store|erase)
    # shellcheck disable=SC2086
    ask | git credential-$backend "$op" 2>/dev/null || true
    ;;
esac
